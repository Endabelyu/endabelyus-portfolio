---
import Base from '../../layouts/Base.astro';
import { projects, getProject } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const p = getProject(slug!);
if (!p) return Astro.redirect('/404');
const title = `${p.name} — Naswa Wilantama`;
---
<Base title={title} description={p.outcome}>
  <main class="mx-auto max-w-3xl px-6 py-16">
    <a href="/projects" class="inline-flex items-center gap-1 text-sm text-ink-2 hover:text-accent">← Back to projects</a>

    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-xs uppercase tracking-wide text-ink-3">{p.domain}</span>
        <span class="rounded-xs bg-accent-soft px-2 py-1 text-xs text-accent-pressed">{p.status}</span>
      </div>
      <h1 class="mt-3 flex items-center gap-3 text-4xl tracking-tight sm:text-5xl">
        <span class="inline-block h-3 w-3 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
        {p.name}
      </h1>
      <p class="mt-4 text-lg text-ink-2">{p.outcome}</p>
      {p.result && (
        <p class="mt-4 inline-flex items-center gap-2 rounded-sm bg-accent-soft px-3 py-1.5 text-sm font-medium text-accent-pressed">
          <span aria-hidden="true">↑</span>{p.result}
        </p>
      )}
      <div class="mt-6 flex flex-wrap gap-3">
        {p.url && <a href={p.url} class="rounded-sm bg-accent px-5 py-2.5 text-sm font-medium text-white hover:bg-accent-hover">View live →</a>}
        {p.repo && <a href={p.repo} target="_blank" rel="noopener" class="rounded-sm border border-border-strong px-5 py-2.5 text-sm font-medium hover:border-accent hover:text-accent">View code</a>}
        {p.repoApi && <a href={p.repoApi} target="_blank" rel="noopener" class="rounded-sm border border-border-strong px-5 py-2.5 text-sm font-medium hover:border-accent hover:text-accent">View API code</a>}
        {p.private && <span class="rounded-sm border border-border px-5 py-2.5 text-sm text-ink-3">Private — internal project</span>}
      </div>
    </header>

    {p.screenshot && (
      <div class="mt-12 aspect-video w-full overflow-hidden rounded-md border border-border bg-surface">
        <img src={`/projects/${p.slug}.png`} alt={`${p.name} screenshot`} loading="lazy" class="h-full w-full object-cover" />
      </div>
    )}

    <section class="mt-12">
      <h2 class="text-xl">The problem</h2>
      <p class="mt-3 text-ink-2">{p.problem}</p>
    </section>

    <section class="mt-10">
      <h2 class="text-xl">What it does</h2>
      <ul class="mt-3 space-y-2">
        {p.features.map((f) => (
          <li class="flex gap-3 text-ink-2">
            <span class="mt-2.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            <span>{f}</span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10">
      <h2 class="text-xl">Built with</h2>
      <ul class="mt-3 flex flex-wrap gap-2">
        {p.tech.map((t) => <li class="rounded-xs border border-border px-3 py-1 text-sm text-ink-2">{t}</li>)}
      </ul>
    </section>

    <div class="mt-16 border-t border-border pt-8">
      <a href="/projects" class="text-sm text-ink-2 hover:text-accent">← Back to all projects</a>
    </div>
  </main>
</Base>
