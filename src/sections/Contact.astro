---
import SectionHeading from '../components/SectionHeading.astro';
const channels = [
  { label: 'Email', href: 'mailto:endabelyuproject@gmail.com', text: 'endabelyuproject@gmail.com' },
  { label: 'GitHub', href: 'https://github.com/Endabelyu', text: 'github.com/Endabelyu' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/naswa-wilantama', text: 'linkedin.com/in/naswa-wilantama' },
];
---
<section id="contact" class="relative mx-auto max-w-content overflow-x-clip px-6 py-24">
  <p class="pointer-events-none absolute inset-x-0 top-10 select-none text-center font-display text-[14vw] leading-none text-surface" aria-hidden="true">CONTACT</p>
  <div class="relative">
  <SectionHeading number="05" title="Let's connect" />
  <p class="-mt-6 mb-3 inline-flex items-center gap-2 text-sm font-medium text-success">
    <span class="inline-block h-2 w-2 rounded-full bg-success" aria-hidden="true"></span>
    Available for freelance projects &amp; the right full-time role — remote, worldwide
  </p>
  <p class="mb-8 max-w-md text-lg text-ink-2">Got a project in mind or just want to chat? I'd love to hear from you.</p>
  <ul class="grid gap-3 sm:max-w-md">
    {channels.map((c) => (
      <li>
        <a href={c.href} class="flex items-center justify-between rounded-md border border-border px-4 py-3 hover:border-accent hover:text-accent">
          <span class="text-sm text-ink-3">{c.label}</span>
          <span class="text-sm font-medium">{c.text}</span>
        </a>
      </li>
    ))}
  </ul>
  <a href="/cv.pdf" target="_blank" rel="noopener" class="mt-6 inline-flex items-center gap-2 rounded-sm bg-accent px-6 py-3 text-sm font-medium text-white hover:bg-accent-hover">Download CV (PDF) ↓</a>
  <footer class="mt-24 flex flex-col gap-4 border-t border-border pt-8 text-sm text-ink-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="flex items-center gap-2">
      <svg width="28" height="14" viewBox="0 0 64 32" aria-hidden="true" class="shrink-0">
        <circle cx="20" cy="16" r="7" fill="#14161A"></circle>
        <circle cx="44" cy="16" r="7" fill="#14161A"></circle>
        <rect x="20" y="14.5" width="24" height="3" fill="#14161A"></rect>
      </svg>
      Built with care by Naswa Wilantama © 2026.
    </p>
    <div class="flex items-center gap-5">
      <a href="https://github.com/Endabelyu" class="hover:text-accent">GitHub</a>
      <a href="https://www.linkedin.com/in/naswa-wilantama" class="hover:text-accent">LinkedIn</a>
      <a href="#top" class="hover:text-accent">Back to top ↑</a>
    </div>
  </footer>
  </div>
</section>
