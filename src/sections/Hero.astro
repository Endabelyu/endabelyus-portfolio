---
import BaymaxEyes from '../components/BaymaxEyes.astro';
---
<section id="top" class="relative mx-auto max-w-content overflow-x-clip px-6 pt-24 pb-32">
  <p class="watermark pointer-events-none absolute inset-x-0 top-16 select-none text-center font-display text-[18vw] leading-none text-surface" data-text="PORTFOLIO" aria-hidden="true"></p>
  <div class="relative grid items-center gap-12 sm:grid-cols-[1.25fr_1fr]">
    <div>
      <p class="font-sans text-ink-2">Hi, I'm</p>
      <h1 class="mt-2 text-5xl leading-[1.02] tracking-tight sm:text-7xl">Naswa Wilantama</h1>
      <p class="mt-3 text-xl font-medium text-ink sm:text-2xl">Fullstack Developer</p>
      <p class="mt-1 text-sm text-ink-3">3 years' experience · based in Indonesia · working worldwide</p>
      <p class="mt-5 max-w-md text-lg text-ink-2">I build enterprise frontends for production systems and ship complete full-stack products solo, from database to deployment.</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href="#projects" class="rounded-sm bg-accent px-6 py-3 text-sm font-medium text-white hover:bg-accent-hover">View Work</a>
        <a href="#contact" class="rounded-sm border border-border-strong px-6 py-3 text-sm font-medium hover:border-accent hover:text-accent">Get in Touch</a>
        <a href="/cv.pdf" target="_blank" rel="noopener" class="text-sm font-medium text-ink-2 underline-offset-4 hover:text-accent hover:underline">Download CV ↓</a>
      </div>
    </div>
    <div class="flex justify-center sm:justify-end">
      <BaymaxEyes class="w-full max-w-xs lg:max-w-sm" />
    </div>
  </div>
</section>
