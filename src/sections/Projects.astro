---
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects, projects } from '../data/projects';
---
<section id="projects" class="relative mx-auto max-w-content overflow-x-clip px-6 py-24">
  <p class="watermark pointer-events-none absolute inset-x-0 top-10 select-none text-center font-display text-[14vw] leading-none text-surface" data-text="PROJECTS" aria-hidden="true"></p>
  <div class="relative">
    <SectionHeading number="03" title="Selected work" />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {featuredProjects.map((p) => <ProjectCard project={p} />)}
    </div>
    <a href="/projects" class="mt-10 inline-flex items-center gap-1 rounded-sm border border-border-strong px-6 py-3 text-sm font-medium hover:border-accent hover:text-accent">
      View all {projects.length} projects →
    </a>
  </div>
</section>
