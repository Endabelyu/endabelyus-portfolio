---
const links = [
  { href: '/#about', label: 'About' },
  { href: '/#skills', label: 'Skills' },
  { href: '/projects', label: 'Projects' },
  { href: '/#contact', label: 'Contact' },
];
---
<nav class="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur">
  <div class="mx-auto flex max-w-content items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center gap-1.5" aria-label="Naswa Wilantama — home">
      <img src="/endabelyu.logo.svg" alt="Naswa Wilantama" width="48" height="48" class="h-10 w-auto" />
      <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
    </a>

    <div class="flex items-center gap-6">
      <!-- Desktop links -->
      <ul class="hidden items-center gap-6 text-sm text-ink-2 sm:flex">
        {links.map((l) => <li><a href={l.href} class="inline-flex items-center py-2 hover:text-accent">{l.label}</a></li>)}
      </ul>

      <!-- CV button (desktop) -->
      <a href="/cv.pdf" target="_blank" rel="noopener" class="hidden rounded-sm border border-border-strong px-4 py-2 text-sm font-medium hover:border-accent hover:text-accent sm:inline-flex">Download CV</a>

      <!-- Mobile hamburger -->
      <button
        type="button"
        data-menu-toggle
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-9 w-9 items-center justify-center rounded-sm border border-border sm:hidden"
      >
        <svg data-icon-open width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="7" x2="20" y2="7"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="17" x2="20" y2="17"></line></svg>
        <svg data-icon-close class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"></line><line x1="18" y1="6" x2="6" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu panel -->
  <ul id="mobile-menu" data-mobile-menu hidden class="border-t border-border px-6 py-2 sm:hidden">
    {links.map((l) => (
      <li><a href={l.href} class="block py-3 text-ink-2 hover:text-accent" data-menu-link>{l.label}</a></li>
    ))}
    <li><a href="/cv.pdf" target="_blank" rel="noopener" class="block py-3 font-medium text-accent" data-menu-link>Download CV ↓</a></li>
  </ul>
</nav>
<script>
  const btn = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  const iconOpen = btn?.querySelector('[data-icon-open]');
  const iconClose = btn?.querySelector('[data-icon-close]');
  const setOpen = (open: boolean) => {
    if (!btn || !menu) return;
    menu.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  };
  btn?.addEventListener('click', () => setOpen(menu?.hidden ?? true));
  menu?.querySelectorAll('[data-menu-link]').forEach((a) =>
    a.addEventListener('click', () => setOpen(false)),
  );
</script>
